<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.RoadSense.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.RoadSense.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.RoadSense.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.RoadSense.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Widget.RoadSense.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/accent_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.RoadSense.Button.Hero" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:minHeight">54dp</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="Widget.RoadSense.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface_elevated</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.RoadSense.Card.Menu" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_elevated</item>
        <item name="strokeColor">@color/gray_200</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.RoadSense.IconCircle" parent="">
        <item name="android:padding">10dp</item>
    </style>

    <style name="Widget.RoadSense.IconCircle.Blue">
        <item name="android:background">@drawable/bg_icon_circle_blue</item>
    </style>

    <style name="Widget.RoadSense.IconCircle.Green">
        <item name="android:background">@drawable/bg_icon_circle_green</item>
    </style>

    <style name="Widget.RoadSense.Chip" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

</resources>
